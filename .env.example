LLMQUANT_API_KEY=your_api_key
LLMQUANT_BASE_URL=https://api.llmquantdata.com
LLMQUANT_API_TIMEOUT_MS=15000

# Local stdio is the default. Set httpStream only for hosted Remote MCP.
LLMQUANT_MCP_TRANSPORT=stdio

# Remote MCP / Streamable HTTP
# LLMQUANT_MCP_TRANSPORT=httpStream
# LLMQUANT_INTERNAL_API_SECRET=replace-with-shared-server-secret
# LLMQUANT_MCP_HOST=::
# LLMQUANT_MCP_PORT=8080  # overrides platform PORT when set
# LLMQUANT_MCP_INTERNAL_PORT=8081
# LLMQUANT_MCP_ENDPOINT=/mcp
# LLMQUANT_MCP_ENABLE_PATH_TOKEN_PROXY=true
# LLMQUANT_MCP_ALLOWED_ORIGINS=https://llmquantdata.com,https://claude.ai
# LLMQUANT_MCP_RATE_LIMIT_WINDOW_MS=60000
# LLMQUANT_MCP_RATE_LIMIT_MAX=120
